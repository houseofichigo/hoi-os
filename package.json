{
  "name": "@house-of-ichigo/os",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "hoi": "bin/hoi.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "build:core": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=4 tests/*.test.mjs",
    "check": "npm test && node scripts/sync-skills.mjs --check && npm run docs:check && npm run expertise:check",
    "skills:sync": "node scripts/sync-skills.mjs",
    "demo": "node scripts/hub-demo.mjs",
    "format": "prettier --write src web scripts tests docs README.md AGENTS.md .github",
    "format:check": "prettier --check src web scripts tests docs README.md AGENTS.md .github",
    "start": "node scripts/start.mjs",
    "test:browser": "npm run build && playwright test",
    "package:release": "node scripts/package-release.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "publication:prepare": "node scripts/publication-safety.mjs",
    "docs:sync": "npm run build && node scripts/sync-guides.mjs",
    "docs:check": "node scripts/sync-guides.mjs --check",
    "hub": "node scripts/start.mjs --surface hub",
    "harness:compare": "node scripts/skill-trials.mjs",
    "harness:recipe": "node scripts/chief-recipe.mjs",
    "demo:hub": "node scripts/hub-demo.mjs",
    "build:hub": "npm run build",
    "hub:stage": "npm run build:hub && node scripts/hub-stage.mjs",
    "hub:acceptance": "node scripts/hub-acceptance.mjs",
    "package:candidate": "npm run build:hub && node scripts/package-candidate.mjs",
    "expertise:sync": "node scripts/sync-expertise.mjs",
    "expertise:check": "node scripts/sync-expertise.mjs --check",
    "expertise:package": "node scripts/package-expertise.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@napi-rs/keyring": "2.1.0",
    "better-sqlite3": "12.11.1",
    "fast-xml-parser": "5.11.1",
    "jszip": "3.10.1",
    "pdfjs-dist": "4.10.38",
    "sqlite-vec": "0.1.9",
    "yaml": "2.9.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.0",
    "prettier": "3.8.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "radix-ui": "1.6.7",
    "react-force-graph-3d": "1.29.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/houseofichigo/hoi-os.git"
  },
  "hoiSurface": "knowledge-hub"
}
