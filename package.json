{
  "name": "@house-of-ichigo/os",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "hoi": "bin/hoi.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "build:core": "tsc -p tsconfig.json",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "check": "npm test && npm run build && node scripts/sync-skills.mjs --check",
    "skills:sync": "node scripts/sync-skills.mjs",
    "demo": "node scripts/demo.mjs",
    "format": "prettier --write src web scripts tests docs README.md AGENTS.md .github",
    "format:check": "prettier --check src web scripts tests docs README.md AGENTS.md .github",
    "start": "node scripts/start.mjs",
    "test:browser": "npm run build && playwright test",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "fast-xml-parser": "5.11.1",
    "jszip": "3.10.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-force-graph-3d": "1.29.1",
    "yaml": "2.9.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.0",
    "prettier": "3.8.1",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/houseofichigo/hoi-os.git"
  }
}
